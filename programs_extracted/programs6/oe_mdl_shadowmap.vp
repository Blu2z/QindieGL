#include "oe_common.cg"

#ifdef SKINNED_MESH

	struct SInData
	{
		float4 pos	    : POSITION;
		float2 bone_id  : TEXCOORD1; 
		float2 bone_w   : TEXCOORD2; 
	};

#else

	struct SInData
	{
		float4 pos	    : POSITION;
   	};

#endif

struct SOutData
{
    float4 hpos  : POSITION;
};

//uniform float4x4  inst_matrix;		//instancing matrix

//======================================================================
#ifdef SKINNED_MESH
	#include "oe_skinning.cg"
#endif

SOutData main(SInData in_data)
{
	SOutData out_data;

	float4	 pos  = 0;	//model space position

#ifdef SKINNED_MESH

	SSkinningResult sr =  skinning(in_data.pos, float3(0.0, 0.0, 0.0), float3(0.0, 0.0, 0.0), in_data.bone_id, in_data.bone_w);

	pos		= sr.pos;

#else

	pos		= in_data.pos;

#endif

	out_data.hpos	= mul(glstate.matrix.mvp, pos );

	return out_data;
}
