/////////////////////////////////////////////////
// DS2 Engine shader (C) 2004 Dmitry Sytnik
// Hardware Matrix Palette Skinning
/////////////////////////////////////////////////


struct indata
{
    float4 POS  : POSITION;
    float2 TEX0 : TEXCOORD0;
    float4 B_W	: TEXCOORD1; //bone weights
    float4 B_IDX: TEXCOORD2; //bone indices
};

struct outdata
{
	float4 POS  : POSITION;
    float2 TEX0 : TEXCOORD0;
    float4 COL0 : COLOR0;
};



////////////////////////////////////////////////////

outdata main(indata IN,
			 uniform float4 bones_matrices[90]	 )
{
	outdata OUT;


	float3 rez_pos=0;


	for(int i=0;i<4;i++)
	{
	
		float matr_index=IN.B_IDX[i];
		
		matr_index*=3;
		
		float3x4 model=float3x4(bones_matrices[matr_index+0],
								bones_matrices[matr_index+1],
								bones_matrices[matr_index+2]);
		
		
		float3 bone_position=mul(model,IN.POS);
		

		
		//rez_pos+=(IN.B_W[i]*bone_position);
		
		rez_pos+=bones_matrices[matr_index+2]*123;
	
	}
	
	
	float4 full_rez_pos;
	
	full_rez_pos.x=rez_pos.x;
	full_rez_pos.y=rez_pos.y;
	full_rez_pos.z=rez_pos.z;
	full_rez_pos.w=1.0;
	
    OUT.POS = mul(glstate.matrix.mvp, full_rez_pos);
    OUT.TEX0 = IN.TEX0;
    OUT.COL0 = float4(1.0,1.0,1.0,1.0);
	
     
	return OUT;
}
